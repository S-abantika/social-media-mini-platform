# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string in production)
MONGO_URI=mongodb://127.0.0.1:27017/connectly

# Security (Use a long random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Client URL for CORS (comma-separated if multiple domains)
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Configuration (Recommended for production to persist user/post images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
