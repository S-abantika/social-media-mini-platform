# Production API Base URL (Point to your deployed backend URL + /api)
# Example: https://connectly-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Production Socket Server URL (Point to your deployed backend domain)
# Example: https://connectly-api.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# Backend Root Domain for static uploads fallback
# Example: https://connectly-api.onrender.com
VITE_SERVER_URL=http://localhost:5000
